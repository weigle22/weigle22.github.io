{
	"name": "weigle22.github.io",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"fetch:github": "node scripts/fetch-github-stats.ts",
		"build:angular": "npm --prefix angular-widgets run build && node scripts/copy-angular.mjs",
		"build": "vite build",
